<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MultiLanguageFoodOrderingApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/dark_orange</item>
        <item name="colorTextPrimary">@color/orange</item>
        <item name="colorBg">@color/white</item>
        <item name="chipStrokeColor">@color/red</item>
        <item name="colorChipBackgroundUnselected">@color/grey</item>
        <item name="rippleColor">@color/silver</item>
        <item name="colorTextChip">@color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="colorFoodName">@color/mint_green</item>
        <item name="colorFoodPrice">@color/black</item>
        <item name="colorCardStroke">@color/silver</item>
    </style>

    <style name="Theme.MultiLanguageFoodOrderingApp" parent="Base.Theme.MultiLanguageFoodOrderingApp" />

    <!-- Splash Theme. -->
    <style name="Theme.MultiLanguageFoodOrderingApp.Splash" parent="Base.Theme.MultiLanguageFoodOrderingApp">
        <item name="android:windowBackground">
            @drawable/splash_background
        </item>
    </style>

</resources>